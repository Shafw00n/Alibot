# Salin file ini menjadi .env, lalu isi API key Gemini Anda.
GEMINI_API_KEY=

# Model mengikuti nama model pada modul; ubah nilainya bila perlu.
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_VOICE_MODEL=gemini-3.5-flash
GEMINI_VOICE_OUT_MODEL=gemini-3.5-flash

# Opsional: gunakan nilai acak yang panjang untuk deployment.
FLASK_SECRET_KEY=
FLASK_DEBUG=false